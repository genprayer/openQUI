{
  "version": 3,
  "configurePresets": [
    {
      "name": "native",
      "displayName": "Native Linux build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "ON",
        "OPENQUI_USE_LOCAL_CORSAIR_RESOURCES": "AUTO"
      }
    },
    {
      "name": "local-assets",
      "displayName": "Local original iCUE resources",
      "inherits": "native",
      "binaryDir": "${sourceDir}/build/local-assets",
      "cacheVariables": {
        "OPENQUI_USE_LOCAL_CORSAIR_RESOURCES": "ON"
      }
    },
    {
      "name": "editor",
      "displayName": "VS Code development container",
      "inherits": "native",
      "binaryDir": "${sourceDir}/build/editor"
    },
    {
      "name": "source-only",
      "displayName": "Authored fallback resources only",
      "inherits": "native",
      "binaryDir": "${sourceDir}/build/source-only",
      "cacheVariables": {
        "OPENQUI_USE_LOCAL_CORSAIR_RESOURCES": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native",
      "configurePreset": "native"
    },
    {
      "name": "local-assets",
      "configurePreset": "local-assets"
    },
    {
      "name": "editor",
      "configurePreset": "editor"
    },
    {
      "name": "source-only",
      "configurePreset": "source-only"
    }
  ],
  "testPresets": [
    {
      "name": "native",
      "configurePreset": "native",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "QT_QUICK_BACKEND": "software",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8"
      }
    },
    {
      "name": "local-assets",
      "configurePreset": "local-assets",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "QT_QUICK_BACKEND": "software",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8"
      }
    },
    {
      "name": "editor",
      "configurePreset": "editor",
      "inheritConfigureEnvironment": true,
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "QT_QUICK_BACKEND": "software",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "source-only",
      "configurePreset": "source-only",
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "QT_QUICK_BACKEND": "software",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8"
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
